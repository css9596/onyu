# Publish docs/legal/site/ to GitHub Pages on every push to main.
#
# One-time setup:
#   1. Push this repo to GitHub.
#   2. Repo → Settings → Pages → Source = "GitHub Actions".
#   3. Push a commit (or manually run this workflow). The site will be at
#      https://<username>.github.io/<repo>/
#
# Custom domain (optional): add a CNAME file under docs/legal/site/ with the
# domain (e.g. legal.onyu.app), then point a CNAME DNS record to
# <username>.github.io.

name: Deploy legal pages

on:
  push:
    branches: [main]
    paths:
      - "docs/legal/site/**"
      - ".github/workflows/pages.yml"
  workflow_dispatch:

permissions:
  contents: read
  pages: write
  id-token: write

concurrency:
  group: "pages"
  cancel-in-progress: true

jobs:
  deploy:
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/configure-pages@v5
      - uses: actions/upload-pages-artifact@v3
        with:
          path: docs/legal/site
      - id: deployment
        uses: actions/deploy-pages@v4
